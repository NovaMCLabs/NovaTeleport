<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.novamclabs</groupId>
        <artifactId>NovaTeleport-Parent</artifactId>
        <version>2.0-SNAPSHOT</version>
    </parent>

    <artifactId>NovaTeleport-Bukkit</artifactId>
    <packaging>jar</packaging>

    <dependencies>
        <dependency>
            <groupId>org.spigotmc</groupId>
            <artifactId>spigot-api</artifactId>
            <version>${spigot.api.version}</version>
            <scope>provided</scope>
        </dependency>

        <!--
          spigot-api 26.2 不再传递依赖 bungeecord-chat，
          Player#spigot().sendMessage(BaseComponent...) 需要它（可点击消息 / ActionBar）。
        -->
        <dependency>
            <groupId>net.md-5</groupId>
            <artifactId>bungeecord-chat</artifactId>
            <version>${bungeecord.chat.version}</version>
            <scope>provided</scope>
        </dependency>

        <!--
          Adventure：Towny / PlotSquared 的 API 签名引用了它，javac 解析类型层次时需要这些类。
          仅编译期使用，插件自身不调用 Adventure（Spigot 运行期没有它），因此保持 provided。
        -->
        <dependency>
            <groupId>net.kyori</groupId>
            <artifactId>adventure-api</artifactId>
            <version>${adventure.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>net.kyori</groupId>
            <artifactId>adventure-text-serializer-legacy</artifactId>
            <version>${adventure.version}</version>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>com.novamclabs</groupId>
            <artifactId>NovaTeleport-Common</artifactId>
            <version>${project.parent.version}</version>
        </dependency>

        <!-- Compile-time symbols for optional plugin integrations (not shaded) -->
        <dependency>
            <groupId>com.novamclabs</groupId>
            <artifactId>NovaTeleport-ExternalPluginStubs</artifactId>
            <version>${project.parent.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- Vault API -->
        <dependency>
            <groupId>com.github.MilkBowl</groupId>
            <artifactId>VaultAPI</artifactId>
            <version>1.7.1</version>
            <scope>provided</scope>
        </dependency>

        <!-- SimpleClans：真实 API 构件（CodeMC 上最新为 2.16.0，本插件用到的签名与 2.19.x 一致） -->
        <dependency>
            <groupId>net.sacredlabyrinth.phaed.simpleclans</groupId>
            <artifactId>SimpleClans</artifactId>
            <version>2.16.0</version>
            <scope>provided</scope>
        </dependency>

        <!-- Lands：真实 API 构件（Lands 8.x 的坐标已迁移到 com.incredibleplugins） -->
        <dependency>
            <groupId>com.incredibleplugins</groupId>
            <artifactId>lands-api</artifactId>
            <version>8.0.0</version>
            <scope>provided</scope>
        </dependency>

        <!-- Parties：真实 API 构件（原先用反射，但 FQCN 写错导致适配器恒返回 null） -->
        <dependency>
            <groupId>com.alessiodp.parties</groupId>
            <artifactId>parties-api</artifactId>
            <version>3.2.17</version>
            <scope>provided</scope>
        </dependency>

        <!-- PlaceholderAPI：软依赖，仅编译期；运行期由服务端决定是否存在 -->
        <dependency>
            <groupId>me.clip</groupId>
            <artifactId>placeholderapi</artifactId>
            <version>2.12.3</version>
            <scope>provided</scope>
        </dependency>

        <!-- FoliaLib for unified scheduling (shaded) -->
        <dependency>
            <groupId>com.github.TechnicallyCoded</groupId>
            <artifactId>FoliaLib</artifactId>
            <version>0.4.4</version>
            <scope>compile</scope>
        </dependency>

        <!-- WorldGuard -->
        <dependency>
            <groupId>com.sk89q.worldguard</groupId>
            <artifactId>worldguard-bukkit</artifactId>
            <version>7.0.17</version>
            <scope>provided</scope>
        </dependency>

        <!-- PlotSquared -->
        <dependency>
            <groupId>com.intellectualsites.plotsquared</groupId>
            <artifactId>plotsquared-core</artifactId>
            <version>7.6.0</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>com.intellectualsites.plotsquared</groupId>
            <artifactId>plotsquared-bukkit</artifactId>
            <version>7.6.0</version>
            <scope>provided</scope>
            <exclusions>
                <exclusion>
                    <groupId>com.intellectualsites.plotsquared</groupId>
                    <artifactId>plotsquared-core</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- GriefDefender -->
        <dependency>
            <groupId>com.griefdefender</groupId>
            <artifactId>api</artifactId>
            <version>2.1.1-SNAPSHOT</version>
            <scope>provided</scope>
        </dependency>


        <!-- Towny -->
        <dependency>
            <groupId>com.palmergames.bukkit.towny</groupId>
            <artifactId>towny</artifactId>
            <version>0.103.2.6</version>
            <scope>provided</scope>
        </dependency>

        <!--
          BetterTeams：JitPack 上的 com.github.booksaw:BetterTeams 只是 312 字节的聚合 POM，
          类全在子模块里，直接依赖子模块坐标更可靠。
        -->
        <dependency>
            <groupId>com.github.booksaw.BetterTeams</groupId>
            <artifactId>betterteams</artifactId>
            <version>5.1.4</version>
            <scope>provided</scope>
        </dependency>

        <!-- Guilds -->
        <dependency>
            <groupId>com.github.guilds-plugin</groupId>
            <artifactId>Guilds</artifactId>
            <version>3.5.3.9</version>
            <scope>provided</scope>
            <exclusions>
                <exclusion>
                    <groupId>me.clip</groupId>
                    <artifactId>placeholderapi</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>org.bstats</groupId>
                    <artifactId>bstats-bukkit</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>org.bstats</groupId>
                    <artifactId>bstats-base</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- Floodgate (Bedrock support) -->
        <dependency>
            <groupId>org.geysermc.floodgate</groupId>
            <artifactId>api</artifactId>
            <version>2.2.5-SNAPSHOT</version>
            <scope>provided</scope>
        </dependency>

        <!-- Cumulus (Forms for Bedrock) -->
        <dependency>
            <groupId>org.geysermc.cumulus</groupId>
            <artifactId>cumulus</artifactId>
            <version>1.1.2</version>
            <scope>provided</scope>
        </dependency>

        <!-- Jedis (Redis client, shaded) -->
        <dependency>
            <groupId>redis.clients</groupId>
            <artifactId>jedis</artifactId>
            <version>6.0.0</version>
            <scope>compile</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
                <configuration>
                    <release>${maven.compiler.release}</release>
                    <encoding>UTF-8</encoding>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.5.1</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <minimizeJar>false</minimizeJar>
                            <!-- 只保留运行期真正需要的类；注解类不需要打进发布包 -->
                            <artifactSet>
                                <excludes>
                                    <exclude>com.google.errorprone:error_prone_annotations</exclude>
                                    <exclude>org.jetbrains:annotations</exclude>
                                </excludes>
                            </artifactSet>
                            <relocations>
                                <relocation>
                                    <pattern>com.tcoded.folialib</pattern>
                                    <shadedPattern>com.novamclabs.lib.folialib</shadedPattern>
                                </relocation>
                                <relocation>
                                    <pattern>redis.clients.jedis</pattern>
                                    <shadedPattern>com.novamclabs.lib.jedis</shadedPattern>
                                </relocation>
                                <!--
                                  Jedis 会带进 gson / org.json / slf4j / commons-pool2。
                                  这些包在服务端（Paper/Spigot）通常也存在，若不重定位，
                                  插件自带的副本会覆盖服务端版本并可能影响其他插件。
                                -->
                                <relocation>
                                    <pattern>com.google.gson</pattern>
                                    <shadedPattern>com.novamclabs.lib.gson</shadedPattern>
                                </relocation>
                                <relocation>
                                    <pattern>org.json</pattern>
                                    <shadedPattern>com.novamclabs.lib.json</shadedPattern>
                                </relocation>
                                <relocation>
                                    <pattern>org.slf4j</pattern>
                                    <shadedPattern>com.novamclabs.lib.slf4j</shadedPattern>
                                </relocation>
                                <relocation>
                                    <pattern>org.apache.commons.pool2</pattern>
                                    <shadedPattern>com.novamclabs.lib.pool2</shadedPattern>
                                </relocation>
                            </relocations>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
            </resource>
        </resources>
    </build>
</project>
